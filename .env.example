# ── Flask core ────────────────────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32

# ── Admin ──────────────────────────────────────────────────────────────────
# Comma-separated user IDs with access to /admin/* routes. Defaults to 1.
ADMIN_USER_IDS=1

# ── Database ───────────────────────────────────────────────────────────────
# Full DSN takes priority over individual fields
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ecomfans
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ecomfans

# ── AI providers (platform-level keys) ────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Set to true only if users are allowed to supply their own API keys
ALLOW_USER_API_KEYS=false

# ── Stripe payments ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── SMTP (password reset emails) ──────────────────────────────────────────
# Without SMTP configured, reset URLs are printed to stderr only (dev mode)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.yourdomain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@yourdomain.com
APP_NAME=EcomFans

# ── Redis (rate limiting) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Error tracking ─────────────────────────────────────────────────────────
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Fraction of transactions to trace (0.0–1.0). Default: 0.05 (5%)
SENTRY_TRACES_SAMPLE_RATE=0.05

# ── Media / uploads ────────────────────────────────────────────────────────
MEDIA_ROOT=instance/media
WORKER_UPLOAD_ROOT=instance/worker_uploads
MAX_CONTENT_LENGTH_MB=32

# ── Session / cookie ───────────────────────────────────────────────────────
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_HOURS=12

# ── Rate limiting ──────────────────────────────────────────────────────────
# Comma-separated IPs of trusted reverse proxies (e.g. your load balancer)
# Only these IPs are allowed to set X-Forwarded-For
TRUSTED_PROXIES=

# ── Encryption ────────────────────────────────────────────────────────────
# Fernet key for encrypting stored API keys (generate with Fernet.generate_key())
FERNET_KEY=your-fernet-key-here
